# Local only: sqlite:///./veriflow.db
DATABASE_URL=sqlite:///./veriflow.db
# Production: postgres database URL, TLS termination, secure cookies
COOKIE_SECURE=false
# Change to your actual production origin (https://example.com) if needed
ALLOWED_ORIGIN=

# Strict role mode is default; demo permits multiple roles per project. Not a public safety guarantee.
VERIFLOW_MODE=production
# Store evidence outside app/static; back up with the database.
VERIFLOW_UPLOAD_DIR=./.veriflow_uploads
